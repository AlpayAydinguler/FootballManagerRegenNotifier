<Project Sdk="Microsoft.NET.Sdk">

  <!--
    net10.0-windows, but deliberately NOT net10.0-windows10.0.19041.0.

    The WinRT TFM would only buy us Windows.Media.Ocr, and its platform floor is
    contagious upward through project references: adopting it here would drag the
    App project up too. See docs/PROJECT_SPEC.md "Decision 1".

    Also deliberately NOT set: UseWPF, UseWindowsForms. Nothing in this project
    touches System.Drawing or System.Windows.Forms. Frames cross every boundary
    as CapturedFrame (a managed byte[]), which is what keeps this project free of
    GDI handle ownership.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FootballManagerRegenNotifier.Capture</RootNamespace>
    <AssemblyName>FootballManagerRegenNotifier.Capture</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FootballManagerRegenNotifier.Core\FootballManagerRegenNotifier.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FootballManagerRegenNotifier.Capture.Tests" />
  </ItemGroup>

</Project>
