<Window x:Class="FootballManagerRegenNotifier.App.Views.SnipOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select the date region"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        Cursor="Cross"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!--
        AllowsTransparency is deliberately left False. It would force the whole
        window into software rendering, and at 2560x1440 that is a visible cost
        for no benefit: the backdrop is an opaque screenshot and the dimming is a
        translucent rectangle drawn inside the window, not window transparency.
    -->

    <Grid x:Name="Root">
        <!-- Frozen screenshot of the desktop, so the game underneath cannot
             repaint, flicker, or lose fullscreen while the user is dragging. -->
        <Image x:Name="Backdrop" Stretch="Fill" />

        <!-- Dimming, punched through by the selection. -->
        <Canvas x:Name="Shade">
            <Rectangle x:Name="ShadeTop" Fill="#96000000" />
            <Rectangle x:Name="ShadeBottom" Fill="#96000000" />
            <Rectangle x:Name="ShadeLeft" Fill="#96000000" />
            <Rectangle x:Name="ShadeRight" Fill="#96000000" />
        </Canvas>

        <Canvas x:Name="Overlay">
            <Rectangle x:Name="Selection"
                       Stroke="#34C77B"
                       StrokeThickness="1.5"
                       Visibility="Collapsed" />

            <Border x:Name="Readout"
                    Background="#EE11151C"
                    BorderBrush="#34C77B"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="8,5"
                    Visibility="Collapsed">
                <TextBlock x:Name="ReadoutText"
                           Foreground="#F0F4F8"
                           FontFamily="Consolas"
                           FontSize="12" />
            </Border>
        </Canvas>

        <Border VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,28,0,0"
                Background="#EE11151C"
                BorderBrush="#2A3342"
                BorderThickness="1"
                CornerRadius="6"
                Padding="18,10">
            <StackPanel>
                <TextBlock Foreground="#F0F4F8"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Text="Drag a box around the in-game date" />
                <TextBlock Foreground="#93A1B5"
                           FontSize="12"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"
                           Text="Leave a little room around the digits — a clipped 7 reads as a 1.  Esc to cancel." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
