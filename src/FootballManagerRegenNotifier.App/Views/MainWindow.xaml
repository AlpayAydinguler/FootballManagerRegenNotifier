<Window x:Class="FootballManagerRegenNotifier.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FootballManagerRegenNotifier.App.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="FM Regen Notifier"
        Height="880" Width="1180"
        MinHeight="640" MinWidth="960"
        Background="{StaticResource Surface0}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <ObjectDataProvider x:Key="SortOptions" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="vm:CountrySort" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="260" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" MinHeight="90" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- === header === -->
        <Border Grid.Row="0" Background="{StaticResource Surface1}" BorderBrush="{StaticResource Border0}"
                BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Text2}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Foreground="{StaticResource Text2}" FontSize="11">
                            <Run Text="In-game date:" />
                            <Run Text="{Binding LastSeenDate, Mode=OneWay}" FontFamily="Consolas"
                                 Foreground="{StaticResource Text1}" />
                            <Run Text="   ·   Next intake:" />
                            <Run Text="{Binding NextIntakeText, Mode=OneWay}" Foreground="{StaticResource Text1}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding GameStatus}" Foreground="{StaticResource Text2}"
                               VerticalAlignment="Center" Margin="0,0,14,0" FontSize="11" />
                    <Button Content="Start monitoring" Command="{Binding StartCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" MinWidth="130" />
                    <Button Content="Stop" Command="{Binding StopCommand}" MinWidth="80" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- === tabs === -->
        <TabControl x:Name="Tabs" Grid.Row="1" Background="Transparent" BorderBrush="{StaticResource Border0}"
                    BorderThickness="1" Padding="0">

            <!-- === capture and OCR === -->
            <TabItem Header="Capture &amp; OCR">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="392" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- region -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="SCREEN REGION" Style="{StaticResource SectionHeader}" />

                            <Grid IsEnabled="{Binding IsIdle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Top-left X" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding TopLeftX, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Top-left Y" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding TopLeftY, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                                    <TextBlock Text="Bottom-right X" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding BottomRightX, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,10,0,0">
                                    <TextBlock Text="Bottom-right Y" Style="{StaticResource Caption}" />
                                    <TextBox Text="{Binding BottomRightY, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Foreground="{StaticResource Text2}" FontSize="11">
                                    <Run Text="Size:" />
                                    <Run Text="{Binding RegionSize, Mode=OneWay}" Foreground="{StaticResource Text1}" />
                                </TextBlock>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Reset" Command="{Binding ResetRegionCommand}"
                                            IsEnabled="{Binding IsIdle}" Margin="0,0,8,0" />
                                    <Button Content="Select on screen…" Command="{Binding SnipCommand}"
                                            Style="{StaticResource PrimaryButton}" />
                                </StackPanel>
                            </Grid>

                            <Border Background="{StaticResource Surface1}" BorderBrush="{StaticResource Border0}"
                                    BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
                                <TextBlock Foreground="{StaticResource Text2}" FontSize="11">
                                    <Run Text="Cursor position:" />
                                    <Run Text="{Binding CursorPosition, Mode=OneWay}"
                                         FontFamily="Consolas" Foreground="{StaticResource Accent}" />
                                </TextBlock>
                            </Border>

                            <TextBlock Text="OCR TUNING" Style="{StaticResource SectionHeader}" Margin="0,22,0,10" />

                            <StackPanel IsEnabled="{Binding IsIdle}">
                                <TextBlock Style="{StaticResource Caption}">
                                    <Run Text="Upscale factor:" />
                                    <Run Text="{Binding UpscaleFactor, Mode=OneWay}" Foreground="{StaticResource Text0}" />
                                    <Run Text="×" Foreground="{StaticResource Text0}" />
                                </TextBlock>
                                <Slider Minimum="1" Maximum="6" TickFrequency="1"
                                        Value="{Binding UpscaleFactor}" />

                                <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,3">
                                    <Run Text="Binarization threshold:" />
                                    <Run Text="{Binding Threshold, Mode=OneWay}" Foreground="{StaticResource Text0}" />
                                </TextBlock>
                                <Slider Minimum="0" Maximum="255" TickFrequency="1"
                                        Value="{Binding Threshold}" />

                                <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,3">
                                    <Run Text="Quiet-zone padding:" />
                                    <Run Text="{Binding QuietZonePixels, Mode=OneWay}" Foreground="{StaticResource Text0}" />
                                    <Run Text="px" Foreground="{StaticResource Text0}" />
                                </TextBlock>
                                <Slider Minimum="0" Maximum="48" TickFrequency="1"
                                        Value="{Binding QuietZonePixels}" />

                                <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,3">
                                    <Run Text="Stroke thickening:" />
                                    <Run Text="{Binding StrokeThickenPasses, Mode=OneWay}" Foreground="{StaticResource Text0}" />
                                    <Run Text="pass(es)" Foreground="{StaticResource Text0}" />
                                </TextBlock>
                                <Slider Minimum="0" Maximum="4" TickFrequency="1"
                                        Value="{Binding StrokeThickenPasses}"
                                        ToolTip="Raise this if 7s are being read as 1s or slashes." />

                                <CheckBox Content="Black &amp; white (otherwise grayscale)" Margin="0,14,0,0"
                                          IsChecked="{Binding BlackAndWhite}" />

                                <TextBlock Text="Polarity" Style="{StaticResource Caption}" Margin="0,12,0,3" />
                                <ComboBox ItemsSource="{Binding InvertModes}" SelectedItem="{Binding Invert}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescription}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <CheckBox Content="Restrict to these characters" Margin="0,14,0,0"
                                          IsChecked="{Binding UseWhitelist}" />
                                <TextBox Text="{Binding Whitelist, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                         IsEnabled="{Binding UseWhitelist}" FontFamily="Consolas" />

                                <CheckBox Content="Use the legacy classifier (strict whitelist)" Margin="0,10,0,0"
                                          IsChecked="{Binding UseLegacyEngine}"
                                          ToolTip="The character whitelist is only enforced strictly by Tesseract's legacy engine." />

                                <TextBlock Text="Date format" Style="{StaticResource Caption}" Margin="0,14,0,3" />
                                <ComboBox ItemsSource="{Binding DateOrders}" SelectedItem="{Binding PreferredDateOrder}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescription}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <CheckBox Content="Learn the format automatically" Margin="0,8,0,0"
                                          IsChecked="{Binding AutoLearnDateOrder}"
                                          ToolTip="Locks the day/month order in once a date with a component above 12 is seen." />

                                <Button Content="Reset OCR settings" Command="{Binding ResetTuningCommand}"
                                        HorizontalAlignment="Left" Margin="0,16,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- live preview -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="WHAT THE OCR ENGINE SEES" Style="{StaticResource SectionHeader}" />

                        <Border Background="#0B0E13" BorderBrush="{StaticResource Border0}" BorderThickness="1"
                                CornerRadius="4" Padding="10" MinHeight="150">
                            <Image Source="{Binding PreviewImage}" Stretch="None"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <Border Background="#2A1A14" BorderBrush="{StaticResource Warn}" BorderThickness="1"
                                CornerRadius="4" Padding="10,7" Margin="0,10,0,0"
                                Visibility="{Binding HasPreviewWarning, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding PreviewWarning}" TextWrapping="Wrap"
                                       Foreground="{StaticResource Warn}" FontSize="12" />
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Raw text" Style="{StaticResource Caption}"
                                       Margin="0,0,14,8" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RawText}" FontFamily="Consolas"
                                       FontSize="15" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Parsed date" Style="{StaticResource Caption}"
                                       Margin="0,0,14,8" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ParsedDate}" FontFamily="Consolas"
                                       FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                       Margin="0,0,0,8" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Confidence" Style="{StaticResource Caption}"
                                       Margin="0,0,14,8" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConfidenceText}"
                                       Foreground="{StaticResource Text1}" Margin="0,0,0,8" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Engine" Style="{StaticResource Caption}"
                                       Margin="0,0,14,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EngineStatus}"
                                       Foreground="{StaticResource Text2}" TextWrapping="Wrap" FontSize="11" />
                        </Grid>

                        <Border Background="{StaticResource Surface1}" BorderBrush="{StaticResource Border0}"
                                BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="If a 7 is being read as a 1" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text1}" Margin="0,0,0,6" />
                                <TextBlock Foreground="{StaticResource Text2}" FontSize="11" TextWrapping="Wrap"
                                           Text="Widen the region first — a crossbar clipped by the capture edge really is a 1, and no setting recovers it. Then raise the threshold towards 160, and add a stroke-thickening pass if the glyphs look like hairlines." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- === countries === -->
            <TabItem Header="Countries">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" IsEnabled="{Binding IsIdle}">
                            <Button Content="Select all" Command="{Binding SelectAllCommand}" Margin="0,0,8,0" />
                            <Button Content="Deselect all" Command="{Binding DeselectAllCommand}" Margin="0,0,8,0" />
                            <Button Content="Select top tier" Command="{Binding SelectTopTierCommand}" Margin="0,0,8,0" />
                            <TextBox Width="52" VerticalContentAlignment="Center"
                                     Text="{Binding TopTierThreshold, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                     ToolTip="Youth rating at or above which 'Select top tier' ticks a country." />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedSummary}" VerticalAlignment="Center"
                                       Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,14,0" />
                            <TextBlock Text="Sort by" VerticalAlignment="Center"
                                       Foreground="{StaticResource Text2}" FontSize="11" Margin="0,0,6,0" />
                            <ComboBox Width="130" ItemsSource="{Binding Source={StaticResource SortOptions}}"
                                      SelectedItem="{Binding SortBy}" />
                            <Button Content="Reload" Command="{Binding ReloadCountriesCommand}" Margin="8,0,0,0"
                                    ToolTip="Re-read data/countries.xlsx from disk." />
                        </StackPanel>
                    </Grid>

                    <!--
                        Virtualization is explicitly OFF.

                        Wrapping the ItemsPresenter in an Expander measures it with
                        infinite height, so a VirtualizingStackPanel realises every
                        container anyway; leaving the virtualization attributes on
                        would only imply a guarantee that is not delivered. At ~90
                        rows the full realisation costs nothing.
                    -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding CountriesCollectionView}"
                             Background="{StaticResource Surface1}"
                             BorderBrush="{StaticResource Border0}"
                             BorderThickness="1"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="False"
                             HorizontalContentAlignment="Stretch">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CountryRowViewModel}">
                                <Grid Margin="30,2,10,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              Content="{Binding Country}"
                                              IsChecked="{Binding IsSelected}"
                                              ToolTip="{Binding Tooltip}"
                                              IsEnabled="{Binding DataContext.IsIdle,
                                                  RelativeSource={RelativeSource AncestorType=ListBox}}" />

                                    <TextBlock Grid.Column="1" Text="{Binding RatingDisplay}"
                                               Foreground="{StaticResource Text1}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" Margin="0,0,16,0" FontFamily="Consolas" />

                                    <TextBlock Grid.Column="2" Text="{Binding Window}"
                                               Foreground="{StaticResource Text1}" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="3" Text="{Binding Confidence}"
                                               Foreground="{Binding Confidence, Converter={StaticResource ConfidenceBrush}}"
                                               VerticalAlignment="Center" FontSize="10"
                                               ToolTip="{Binding Tooltip}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <Expander IsExpanded="True" Margin="0,2"
                                                              Background="Transparent"
                                                              Foreground="{StaticResource Text0}">
                                                        <Expander.Header>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                           FontSize="13" />
                                                                <TextBlock Foreground="{StaticResource Text2}"
                                                                           FontSize="11" VerticalAlignment="Center"
                                                                           Margin="8,0,0,0">
                                                                    <Run Text="(" /><Run
                                                                        Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Expander.Header>
                                                        <ItemsPresenter />
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- === alerts and options === -->
            <TabItem Header="Alerts &amp; Options">
                <ScrollViewer Margin="14" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ALERTS" Style="{StaticResource SectionHeader}" />
                            <CheckBox Content="Play a sound" IsChecked="{Binding AlertSound}" />
                            <CheckBox Content="Flash the taskbar button" IsChecked="{Binding AlertFlashWindow}" />
                            <CheckBox Content="Show a tray notification" IsChecked="{Binding AlertTrayBalloon}" />
                            <CheckBox Content="Bring the window to the front" IsChecked="{Binding AlertBringToFront}"
                                      ToolTip="Off by default: this steals focus from the game." />
                            <Button Content="Test alert" Command="{Binding TestAlertCommand}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" />

                            <TextBlock Text="TIMING" Style="{StaticResource SectionHeader}" Margin="0,24,0,10" />
                            <TextBlock Text="Check interval (ms)" Style="{StaticResource Caption}" />
                            <TextBox Width="110" HorizontalAlignment="Left"
                                     Text="{Binding PollIntervalMs, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                     IsEnabled="{Binding IsIdle}" />
                            <TextBlock Text="Warn this many days before the window opens (0 = on the day)"
                                       Style="{StaticResource Caption}" Margin="0,12,0,3" />
                            <TextBox Width="110" HorizontalAlignment="Left"
                                     Text="{Binding LeadDays, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                     IsEnabled="{Binding IsIdle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PRIVACY" Style="{StaticResource SectionHeader}" />
                            <TextBlock Foreground="{StaticResource Text2}" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,0,0,10"
                                       Text="With these off, a monitoring session left running reads whatever happens to sit at those coordinates and writes the text to a log file. Leave them on unless you have a reason not to." />
                            <CheckBox Content="Only read the screen while Football Manager is running"
                                      IsChecked="{Binding RequireGameRunning}" IsEnabled="{Binding IsIdle}" />
                            <CheckBox Content="…and only while it is the active window"
                                      IsChecked="{Binding RequireGameForeground}" IsEnabled="{Binding IsIdle}" />
                            <TextBlock Text="Game process name" Style="{StaticResource Caption}" Margin="0,12,0,3" />
                            <TextBox Width="160" HorizontalAlignment="Left"
                                     Text="{Binding GameProcessName, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                     IsEnabled="{Binding IsIdle}" />

                            <TextBlock Text="WINDOW" Style="{StaticResource SectionHeader}" Margin="0,24,0,10" />
                            <CheckBox Content="Minimise to the notification area" IsChecked="{Binding MinimiseToTray}" />

                            <TextBlock Text="COUNTRY LIST" Style="{StaticResource SectionHeader}" Margin="0,24,0,10" />
                            <CheckBox Content="Include lower-league rows in 'Select top tier'"
                                      IsChecked="{Binding TopTierIncludesLowerLeagues}" IsEnabled="{Binding IsIdle}" />
                            <TextBlock Foreground="{StaticResource Text2}" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,10,0,0"
                                       Text="Edit data/countries.xlsx to adapt this to another Football Manager edition, then press Reload on the Countries tab." />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent"
                      ResizeBehavior="PreviousAndNext" />

        <!-- === activity log === -->
        <Border Grid.Row="3" Background="{StaticResource Surface1}" BorderBrush="{StaticResource Border0}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="12,8">
                    <TextBlock Text="ACTIVITY LOG" Style="{StaticResource SectionHeader}" Margin="0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox Content="Verbose" IsChecked="{Binding Log.ShowDetail}" Margin="0,0,12,0"
                                  FontSize="11" />
                        <CheckBox Content="Auto-scroll" IsChecked="{Binding Log.AutoScroll}" Margin="0,0,12,0"
                                  FontSize="11" />
                        <Button Content="Copy" Click="OnCopyLog" Padding="8,3" FontSize="11" Margin="0,0,6,0" />
                        <Button Content="Clear" Command="{Binding ClearLogCommand}" Padding="8,3" FontSize="11" />
                    </StackPanel>
                </Grid>

                <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Log.Entries}"
                         Background="Transparent" BorderThickness="0" Margin="4,0,4,4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="8,1">
                                <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource Text2}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding Message}" Foreground="{Binding Colour}"
                                           FontSize="12" TextWrapping="Wrap" MaxWidth="1000" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- === status bar === -->
        <TextBlock Grid.Row="4" Margin="2,8,2,0" FontSize="10" Foreground="{StaticResource Text2}"
                   TextWrapping="Wrap"
                   Text="Read-only. Never writes to the game. Single-player use. Not affiliated with Sports Interactive or SEGA." />
    </Grid>
</Window>
