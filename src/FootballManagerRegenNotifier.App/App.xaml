<Application x:Class="FootballManagerRegenNotifier.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FootballManagerRegenNotifier.App.Converters">
    <Application.Resources>
        <ResourceDictionary>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:ConfidenceBrushConverter x:Key="ConfidenceBrush" />
            <conv:EnumDescriptionConverter x:Key="EnumDescription" />

            <!-- Palette -->
            <SolidColorBrush x:Key="Surface0" Color="#11151C" />
            <SolidColorBrush x:Key="Surface1" Color="#171C25" />
            <SolidColorBrush x:Key="Surface2" Color="#1E2530" />
            <SolidColorBrush x:Key="Border0"  Color="#2A3342" />
            <SolidColorBrush x:Key="Text0"    Color="#F0F4F8" />
            <SolidColorBrush x:Key="Text1"    Color="#AEBACB" />
            <SolidColorBrush x:Key="Text2"    Color="#7C8899" />
            <SolidColorBrush x:Key="Accent"   Color="#34C77B" />
            <SolidColorBrush x:Key="AccentDim" Color="#1F6F48" />
            <SolidColorBrush x:Key="Warn"     Color="#E8A33D" />
            <SolidColorBrush x:Key="Danger"   Color="#E56B6B" />

            <!-- Base typography -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Text0}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            </Style>

            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Text2}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Margin" Value="0,0,0,3" />
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource Text1}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{StaticResource Text1}" />
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource Text0}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,3" />
            </Style>

            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource Text0}" />
                <Setter Property="Margin" Value="0,3,14,3" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource Surface2}" />
                <Setter Property="Foreground" Value="{StaticResource Text0}" />
                <Setter Property="BorderBrush" Value="{StaticResource Border0}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="CaretBrush" Value="{StaticResource Text0}" />
            </Style>

            <!--
                ComboBox needs a full template, not just brushes.

                Its stock chrome is a nested ToggleButton with hardcoded light
                colours that ignore Background entirely, so setting properties
                alone leaves near-white text on near-white and genuinely
                unreadable rather than merely off-brand.
            -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource Text0}" />
                <Setter Property="Padding" Value="9,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#28313E" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="{StaticResource Text0}" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Box"
                                                    Background="{StaticResource Surface2}"
                                                    BorderBrush="{StaticResource Border0}"
                                                    BorderThickness="1" CornerRadius="4">
                                                <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Margin="0,0,9,0" Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{StaticResource Text1}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Box" Property="Background" Value="#28313E" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <ContentPresenter IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="9,0,26,0"
                                                  VerticalAlignment="Center" />

                                <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                                       AllowsTransparency="True"
                                       IsOpen="{TemplateBinding IsDropDownOpen}">
                                    <Border Background="{StaticResource Surface2}"
                                            BorderBrush="{StaticResource Border0}"
                                            BorderThickness="1" CornerRadius="4"
                                            MinWidth="{Binding ActualWidth,
                                                RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="320">
                                        <ScrollViewer>
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource Surface2}" />
                <Setter Property="Foreground" Value="{StaticResource Text0}" />
                <Setter Property="BorderBrush" Value="{StaticResource Border0}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#28313E" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource AccentDim}" />
                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- TabControl needs an explicit dark template: the stock one paints a
                 light chrome that leaves the header text unreadable. -->
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource Border0}" />
            </Style>

            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource Text1}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Chrome" Background="Transparent" BorderThickness="0,0,0,2"
                                    BorderBrush="Transparent" Padding="18,9" Margin="0,0,2,0">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#1A212B" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface1}" />
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                                    <Setter Property="Foreground" Value="{StaticResource Text0}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="GroupBox">
                <Setter Property="Foreground" Value="{StaticResource Text1}" />
                <Setter Property="BorderBrush" Value="{StaticResource Border0}" />
                <Setter Property="Margin" Value="0,0,0,14" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <Style TargetType="Slider">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsSnapToTickEnabled" Value="True" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
