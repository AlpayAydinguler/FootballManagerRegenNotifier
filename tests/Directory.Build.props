<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Underscored test names (Method_Scenario_Expectation) are the convention
         here and read better than the alternative. CA1707 disagrees; CI treats
         warnings as errors, so silence it for tests only. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

</Project>
