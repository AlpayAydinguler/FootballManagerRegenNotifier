<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FootballManagerRegenNotifier.Capture.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test-only: the OCR integration tests render sample date images with
         System.Drawing. The Capture project itself never references it. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FootballManagerRegenNotifier.Capture\FootballManagerRegenNotifier.Capture.csproj" />
  </ItemGroup>

  <!-- The OCR integration tests need real language data next to the test binary. -->
  <ItemGroup>
    <None Include="..\..\tessdata\eng.traineddata" Link="tessdata\eng.traineddata" Condition="Exists('..\..\tessdata\eng.traineddata')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
